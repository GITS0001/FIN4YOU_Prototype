# Database & Supabase Configuration
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here
SUPABASE_SECRET_KEY=your_supabase_service_role_key_here

# Application Security
SECRET_KEY=your_jwt_secret_key_change_in_production
JWT_SECRET=your_jwt_secret_key_change_in_production
OTP_SECRET=your_otp_secret_key

# Environment Mode: 'production' requires Supabase; 'test' or 'development' allows local mock/fixtures
ENVIRONMENT=development

# Networking & CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Optional Integrations
GEMINI_API=your_gemini_api_key_here
